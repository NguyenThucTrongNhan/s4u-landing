# Ignore Visual Studio working folder
.vs/
*.vscode/

# Ignore design-time build caches
*.db
*_i.db
*_i.db-shm
*_i.db-wal
*.dbcache
*.dbcache.v*
*.ide
*.vsidx
*.suo
*.user
*.userosscache
*.userprefs
*.cache
*.tmp
*.tlog

# Ignore backup files from VS
*.backup.json

####################################
# .NET / Visual Studio
####################################

# Build results
**/bin/
**/obj/

# Rider / VS Code
.idea/
.vscode/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

####################################
# NuGet
####################################

# NuGet packages
*.nupkg
*.snupkg

# NuGet restore artifacts
**/project.assets.json
**/*.csproj.nuget.*
**/packages/

####################################
# Build outputs
####################################

*.dll
*.exe
*.pdb
*.cache
*.log

####################################
# Test results
####################################

TestResults/
*.trx
*.coverage
*.coveragexml

####################################
# OS
####################################

.DS_Store
Thumbs.db

####################################
# Node.js / Frontend
####################################

# Dependencies — never commit these
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
build/
.angular/
**/.angular/

# Package manager lock files (keep package-lock.json / yarn.lock, but ignore caches)
.npm/
.yarn/cache/
.pnp.*

# Environment files
.env
.env.local
.env.*.local

####################################
# Others
####################################

*.editorconfig.user
